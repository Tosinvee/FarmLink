# ===== App =====
NODE_ENV=development
PORT=3000
JWT_SECRET=supersecret-change-me
JWT_EXPIRES_IN=3600s

# ===== PostgreSQL (used inside Docker) =====
DATABASE_URL=postgresql://farmlink:farmlink_password@db:5432/farmlink?schema=public
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=farmlink
DATABASE_PASSWORD=farmlink_password
DATABASE_NAME=farmlink

# The Postgres container reads these to create the user + database
POSTGRES_USER=farmlink
POSTGRES_PASSWORD=farmlink_password
POSTGRES_DB=farmlink

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=redis_password

# ===== Mail (Gmail example) =====
MAIL_SERVICE=Gmail
EMAIL=youremail@gmail.com
APP_PASSWORD=your-16-digit-app-password