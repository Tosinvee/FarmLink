generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FARMER
  CONSUMER
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus{
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  phone         String?
  role          Role      @default(CONSUMER)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  farmer        Farmer?
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  refreshTokens RefreshToken[]
  reviews       Review[]

  @@map("users")
}

model Farmer {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  description String?
  isVerified  Boolean  @default(false)
  rating      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farm          Farm?
  products      Product[]
  reviews       Review[]
  orders        Order[]
  earnings      FarmerEarning[]
  payouts       FarmerPayout[]
  payoutAccount FarmerPayoutAccount?

  @@index([userId])
  @@map("farmers")
}

model Farm {
  id          String   @id @default(uuid())
  farmerId    String   @unique
  farmer      Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  country     String
  state       String
  city        String
  longitude   Float?
  latitude    Float?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("farms")
}

model Review {
  id         String   @id @default(uuid())
  farmerId   String
  reviewerId String
  farmer     Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([farmerId, reviewerId])
  @@map("reviews")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  farmerId    String
  farmId      String?
  categoryId  String
  farmer      Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm        Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  description String?
  price       Int
  quantity    Int      @default(0)
  unit        String   @default("kg")
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([farmerId])
  @@index([categoryId])
  @@map("products")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  street     String
  city       String
  state      String
  country    String   @default("NG")
  latitude   Float?
  longitude  Float?
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  farmerId    String
  addressId   String?
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  farmer      Farmer      @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  address     Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  status      OrderStatus @default(PENDING_PAYMENT)
  subtotal    Int
  deliveryFee Int      @default(0)
  total       Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items    OrderItem[]
  delivery Delivery?
  payment  Payment?
  earnings FarmerEarning[]

  @@index([userId])
  @@index([farmerId])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String?
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String?
  unitPrice    Int
  quantity     Int
  totalPrice   Int

  @@index([orderId])
  @@map("order_items")
}

model Payment{
  id                String         @id @default(uuid())
  orderId           String         @unique
  order             Order          @relation(fields: [orderId], references: [id], onDelete:Cascade)
  reference         String         @unique
  amount            Int
  status            PaymentStatus  @default(PENDING)
  provider          String         @default("paystack")
  providerReference String?
  authorizationUrl  String?
  accessCode        String?
  gatewayResponse   Json?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("payments")
}

model Delivery {
  id                String          @id @default(uuid())
  orderId           String          @unique
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            DeliveryStatus  @default(PENDING)
  courierName       String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("deliveries")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revoked])
  @@map("refresh_tokens")
}

model PlatformSetting {
  id                  Int     @id @default(1)
  commissionRatePct   Float   @default(8)
  minimumPayoutAmount Int     @default(5000)

  @@map("platform_settings")
}

model FarmerPayoutAccount {
  id            String   @id @default(uuid())
  farmerId      String   @unique
  farmer        Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  bankName      String
  accountName   String
  accountNumber String
  bankCode      String?
  isDefault     Boolean  @default(true)
  isVerified    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payouts FarmerPayout[]

  @@map("farmer_payout_accounts")
}

model FarmerEarning {
  id                  String    @id @default(uuid())
  farmerId            String
  orderId             String    @unique
  farmer              Farmer    @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  grossAmount         Int
  platformCommission  Int
  netAmount           Int
  currency            String    @default("NGN")
  isPaidOut           Boolean   @default(false)
  earnedAt            DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([farmerId, orderId])
  @@index([farmerId])
  @@map("farmer_earnings")
}

model FarmerPayout {
  id              String       @id @default(uuid())
  farmerId        String
  payoutAccountId String
  farmer          Farmer       @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  payoutAccount   FarmerPayoutAccount @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  amount          Int
  status          PayoutStatus @default(PENDING)
  reference       String       @unique
  failureReason   String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([farmerId])
  @@map("farmer_payouts")
}